# 藍隊管理系統 — 環境變數樣板
#
# 複製為 .env 後修改。.env 已列入 .gitignore，不會進版控。
#   cp .env.example .env

# ---------- 網路 ----------
BTMS_PORT=8080
BTMS_HOST=0.0.0.0
# 置於 Nginx／Caddy 等反向代理之後時設為 true，才會採信 X-Forwarded-For
BTMS_TRUST_PROXY=false

# ---------- 初始管理員 ----------
# 首次啟動時建立。留空則自動產生隨機密碼並印在容器日誌中（docker logs）。
# 無論哪一種，首次登入都會強制變更密碼。
BTMS_ADMIN_USER=admin
BTMS_ADMIN_PASSWORD=

# ---------- 會話與密碼 ----------
BTMS_SESSION_IDLE_MIN=60          # 閒置多久自動登出
BTMS_SESSION_MAX_HOURS=12         # 單次登入的絕對上限
BTMS_MAX_FAILED_LOGINS=5          # 連續失敗幾次後鎖定
BTMS_LOCKOUT_MIN=15               # 鎖定時間
BTMS_MIN_PW_LEN=12                # 密碼長度下限（中日韓文字以兩個字元計）
# 以 HTTPS 對外時務必設為 true，Cookie 才會帶 Secure 旗標
BTMS_COOKIE_SECURE=false

# ---------- 資料 ----------
# 首次啟動載入示範資料（36 件案件、26 張請求表、31 項資產、21 篇情資、20 份獵補計畫）。
# 正式上線請維持 false。
BTMS_SEED_DEMO=false

# ---------- 附件 ----------
BTMS_UPLOAD_MAX_BYTES=10485760    # 單檔上限（10 MB）
BTMS_UPLOAD_MAX_FILES=10          # 單次請求檔案數上限

# ---------- 備份 ----------
BTMS_BACKUP_ENABLED=true
BTMS_BACKUP_INTERVAL_HOURS=24
BTMS_BACKUP_KEEP=7                # 保留幾份

# ---------- 稽核與日誌 ----------
BTMS_LOG_LEVEL=info               # trace|debug|info|warn|error
BTMS_AUDIT_RETENTION_DAYS=0       # 0 表示永久保留

# ---------- SSO（選用，預設停用）----------
# 啟用後登入頁會多一個 SSO 按鈕。詳見 docs/SSO.md
BTMS_SSO_ENABLED=false
BTMS_SSO_ISSUER=
BTMS_SSO_CLIENT_ID=
BTMS_SSO_CLIENT_SECRET=
BTMS_SSO_REDIRECT_URI=
BTMS_SSO_DEFAULT_PERM=analyst
BTMS_SSO_DEFAULT_ROLE=網路分析員
# IdP 故障時仍可用本地帳密登入，建議保持 true
BTMS_SSO_LOCAL_FALLBACK=true
